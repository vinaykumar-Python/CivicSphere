APP_NAME=CivicCare AI
APP_ENV=development
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/civiccare_ai

# Generate a random secret of at least 64 characters before deployment.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-64-characters-long

# Comma-separated frontend origins; update for your deployment.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ENABLE_SLA_SCHEDULER=true

# Optional email verification configuration.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
